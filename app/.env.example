# Copia a .env (local) o configura estas variables en tu hosting.
# NUNCA subas .env con valores reales al repositorio.

# --- Programador en proceso (solo en instancia siempre activa) ---
ENABLE_SCHEDULER=1
SCHEDULER_TZ=Europe/Madrid

# --- Datos persistentes (carpeta con disco persistente en producción) ---
PATRIMONIO_DATA_DIR=/data

# --- WhatsApp GRATIS (CallMeBot) — opción recomendada ---
# Activa una vez desde tu móvil (ver FREE_SETUP.md) y pega aquí la API key.
CALLMEBOT_APIKEY=
CALLMEBOT_PHONE=34640253466
# Umbral de variación de precio que se destaca en el mensaje, en % y en los DOS
# sentidos (sube o baja). 5 = se avisa de todo lo que se mueva un 5% o más.
ALERT_THRESHOLD=5
# ALERT_SEND_EMPTY=1   # descomenta si quieres el aviso semanal aunque no haya movimientos

# --- WhatsApp (Twilio) — alternativa; necesaria SOLO para recibir PDFs por WhatsApp ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ALERT_WHATSAPP_TO=whatsapp:+34640253466

# --- Precios de skins por CSFloat (opcional; si no, usa Steam Market) ---
CSFLOAT_API_KEY=

# --- Ritmo contra el Steam Market ---
# Segundos entre peticiones de precio. Medido contra la API real: con 1,2 s
# Steam corta por 429 hacia la petición 37; con 3 s aguanta el inventario
# entero. Súbelo si te siguen limitando.
STEAM_MARKET_DELAY=3.0
STEAM_RATE_LIMIT_WAIT=30
STEAM_RATE_LIMIT_RETRIES=2

# --- Tu SteamID64 ---
# Normalmente NO hace falta: está en settings.json (versionado, es público).
# Defínelo solo si quieres sobrescribirlo en este servidor.
# STEAM_ID64=

# --- Seguridad del webhook entrante de WhatsApp (endpoint público) ---
# Si lo defines, el webhook exige ?token=ESTE_VALOR para aceptar peticiones.
WHATSAPP_WEBHOOK_TOKEN=

# --- Resumen mensual de patrimonio por WhatsApp ---
# Token que protege /api/monthly-summary (lo dispara GitHub Actions cada mes).
SUMMARY_TOKEN=

# --- Wealth Reader (banca automática) ---
# API key privada de Wealth Reader (https://www.wealthreader.com). El token de
# cada banco lo genera el widget en el navegador.
WEALTHREADER_API_KEY=

# --- imagin / CaixaBank por PSD2 (Enable Banking) ---
# Registra una aplicación en https://enablebanking.com (modo "restricted
# production": gratis para leer TUS PROPIAS cuentas) y pega aquí sus datos.
ENABLE_BANKING_APP_ID=
# La clave privada de la aplicación: el PEM completo (con \n escapados) o su
# base64. Alternativa: ENABLE_BANKING_KEY_PATH con la ruta al fichero .pem.
ENABLE_BANKING_PRIVATE_KEY=
# ENABLE_BANKING_KEY_PATH=/data/enablebanking.pem
ENABLE_BANKING_COUNTRY=ES
# Banco: OPCIONAL. Si lo dejas vacío, lo eliges en ⚙️ Configuración de la web,
# donde salen los nombres exactos que reconoce Enable Banking (GET /aspsps).
# Definirlo aquí lo fija y bloquea ese selector.
# ENABLE_BANKING_ASPSP=imagin
# URL de retorno: OPCIONAL. Por defecto la web usa su propia ruta de retorno,
# https://<tu-app>/imagin/callback, que es la que se muestra en ⚙️ Configuración
# para que la registres en Enable Banking. Defínela solo si registraste otra.
# ENABLE_BANKING_REDIRECT_URL=

# --- Trade Republic (API no oficial de la propia app) ---
# El emparejado del dispositivo se hace UNA vez desde la web; la clave privada
# queda en la base de datos. El PIN hace falta en cada login automático.
TR_PHONE=+34600000000
TR_PIN=
